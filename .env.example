PORT=3000
# HOST=127.0.0.1          # batasi akses ke mesin ini saja; kosong = semua antarmuka
# Token login /admin.html. WAJIB diisi dengan nilai panjang & acak untuk produksi
# (jika dikosongkan, token acak dicetak di log dan berubah tiap restart).
# ADMIN_TOKEN=

# ---------- PostgreSQL (opsional; kosong = file JSON lokal) ----------
# DATABASE_URL=postgres://rag_user:password@192.168.1.10:5432/rag
# Jika PostgreSQL hanya terbuka di loopback server (mis. 127.0.0.1:5434) dan memakai docker-compose.server.yml:
# DATABASE_URL=postgres://rag_app:password@127.0.0.1:5434/rag
# DATABASE_SSL=            # true | no-verify | (kosong = tanpa SSL)

# ---------- LLM lokal OpenAI-compatible (LM Studio / vLLM / llama.cpp) ----------
# Dari Docker di Windows/Mac: http://host.docker.internal:1234/v1 (LM Studio). Tanpa Docker: http://localhost:1234/v1
# LLM_BASE_URL=http://localhost:1234/v1
# vLLM di loopback server + docker-compose.server.yml: LLM_BASE_URL=http://127.0.0.1:8100/v1
# LLM_MODEL=nama-model-persis-seperti-di-server
# LLM_API_KEY=             # kebanyakan server lokal tidak memerlukannya
# LLM_TEMPERATURE=0.2
# LLM_MAX_TOKENS=800
# LLM_TIMEOUT_MS=300000
# Field tambahan ke permintaan LLM (JSON). Qwen3.x di vLLM: matikan mode berpikir ->
# LLM_EXTRA_BODY={"chat_template_kwargs":{"enable_thinking":false}}

# ---------- Pencarian semantik pgvector (butuh DATABASE_URL) ----------
# EMBEDDING_MODEL=nama-model-embedding
# EMBEDDING_BASE_URL=      # kosong = sama dengan LLM_BASE_URL
# EMBEDDING_DOC_PREFIX=    # mis. "search_document: " (nomic) atau "passage: " (e5)
# EMBEDDING_QUERY_PREFIX=  # mis. "search_query: " (nomic) atau "query: " (e5)
# MIN_SCORE=0.35           # kalibrasi lewat panel "Uji pencarian" di /admin.html

# ---------- Lainnya ----------
# SEED_ON_EMPTY=false      # jangan impor folder knowledge/ saat penyimpanan kosong
# ANTHROPIC_API_KEY=       # opsional, dipakai bila LLM_BASE_URL kosong
DATA_DIR=./data
KNOWLEDGE_DIR=./knowledge
