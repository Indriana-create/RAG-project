PORT=3000
# Wajib diisi untuk produksi: token login halaman /admin.html
ADMIN_TOKEN=ganti-dengan-token-panjang-dan-acak
# Opsional: aktifkan jawaban berbasis LLM (Claude). Tanpa ini, bot memakai mode ekstraktif offline.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Lokasi penyimpanan knowledge (knowledge.json) dan dokumen awal
DATA_DIR=./data
KNOWLEDGE_DIR=./knowledge
