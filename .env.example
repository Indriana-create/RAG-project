PORT=3000
# HOST=127.0.0.1          # batasi akses ke mesin ini saja; kosong = semua antarmuka
# ---------- Akun admin (/admin.html) ----------
# Akun PERTAMA, dibuat sekali saat belum ada akun. Setelah login pertama, hapus ADMIN_PASSWORD dari file ini.
# Tanpa ADMIN_PASSWORD, password acak dicetak sekali di log. Password minimal 8 karakter.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=
# Token API untuk otomasi (n8n), BUKAN untuk login manusia. Kosong = API token nonaktif. Pakai nilai panjang & acak.
# ADMIN_TOKEN=
# Kunci penanda sesi login. Kosong = diturunkan dari ADMIN_TOKEN (atau acak: login ulang tiap restart).
# SESSION_SECRET=
# SESSION_TTL_HOURS=12
# Di belakang Cloudflare Tunnel / reverse proxy: percaya header IP asli & HTTPS dari proxy.
# TRUST_PROXY=true
# COOKIE_SECURE=auto      # auto | true | false
# Impor knowledge dari URL: bawaannya hanya situs di internet publik (alamat internal/privat diblokir agar fitur ini
# tidak bisa dipakai menjangkau layanan di server/LAN, mis. LLM, database, n8n). Aktifkan HANYA bila perlu mengambil
# halaman dari jaringan internal (mis. wiki perusahaan) dan Anda percaya semua admin.
# URL_IMPORT_ALLOW_PRIVATE=false

# ---------- PostgreSQL (opsional; kosong = file JSON lokal) ----------
# DATABASE_URL=postgres://rag_user:password@192.168.1.10:5432/rag
# Jika PostgreSQL hanya terbuka di loopback server (mis. 127.0.0.1:5434) dan memakai docker-compose.server.yml:
# DATABASE_URL=postgres://rag_app:password@127.0.0.1:5434/rag
# DATABASE_SSL=            # true | no-verify | (kosong = tanpa SSL)

# ---------- LLM lokal OpenAI-compatible (LM Studio / vLLM / llama.cpp) ----------
# Dari Docker di Windows/Mac: http://host.docker.internal:1234/v1 (LM Studio). Tanpa Docker: http://localhost:1234/v1
# LLM_BASE_URL=http://localhost:1234/v1
# vLLM di loopback server + docker-compose.server.yml: LLM_BASE_URL=http://127.0.0.1:8100/v1
# LLM_MODEL=nama-model-persis-seperti-di-server
# LLM_API_KEY=             # kebanyakan server lokal tidak memerlukannya
# LLM_TEMPERATURE=0.2
# LLM_MAX_TOKENS=800
# LLM_TIMEOUT_MS=300000
# Field tambahan ke permintaan LLM (JSON). Qwen3.x di vLLM: matikan mode berpikir ->
# LLM_EXTRA_BODY={"chat_template_kwargs":{"enable_thinking":false}}

# ---------- Pencarian semantik pgvector (butuh DATABASE_URL) ----------
# Layanan embedding: docker compose -f docker-compose.embedding.yml up -d (TEI + bge-m3, port 8200)
# EMBEDDING_MODEL=BAAI/bge-m3
# EMBEDDING_BASE_URL=http://127.0.0.1:8200/v1   # kosong = sama dengan LLM_BASE_URL
# EMBEDDING_STARTUP_WAIT_SECONDS=90
# EMBEDDING_DOC_PREFIX=    # mis. "search_document: " (nomic) atau "passage: " (e5)
# EMBEDDING_QUERY_PREFIX=  # mis. "search_query: " (nomic) atau "query: " (e5)
# MIN_SCORE=0.35           # KALIBRASI dengan scripts/calibrate.mjs (skor embedding tiap model berbeda); cek di panel "Uji pencarian"

# ---------- Kepribadian chatbot ----------
# ASSISTANT_NAME=Lumi dari Lumicore
# ASSISTANT_STYLE=Sapa pengguna dengan "Kak" dan gunakan emoji secukupnya.

# ---------- Lainnya ----------
# SEED_ON_EMPTY=false      # jangan impor folder knowledge/ saat penyimpanan kosong
# ANTHROPIC_API_KEY=       # opsional, dipakai bila LLM_BASE_URL kosong
DATA_DIR=./data
KNOWLEDGE_DIR=./knowledge
